# ── Server ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ENABLE_SWAGGER=true

# ── Secrets ────────────────────────────────────────────────
# JWT_SECRET: at least 32 chars
# ENCRYPTION_KEY / MESSAGE_KEY: 64 hex chars each, must differ. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
MESSAGE_KEY=

# ── Database (Supabase → Settings → Database → URI) ────────
DATABASE_URL=

# ── Supabase API (Settings → API) — use the service_role key, never the anon key ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Redis (Upstash, use the rediss:// URL) ─────────────────
REDIS_URL=

# ── OAuth (added with AuthModule) ──────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=
